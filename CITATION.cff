    given-names: Roy T.
    orcid: "https://orcid.org/0000-0002-9997-5515"
  - family-names: Kankelborg
    given-names: Charles C.
    orcid: "https://orcid.org/0000-0002-1992-7469"
repository-code: "https://github.com/Kankelborg-Group/furst-optics"
url: "https://furst-optics.readthedocs.io"
license: BSD-3-Clause
keywords:
  - FURST
  - sounding rocket
  - ultraviolet spectroscopy
  - solar physics
